# Backend server
APP_ENV=development
APP_PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# Neon/PostgreSQL
DATABASE_URL=

# Local JWT
JWT_SECRET=
JWT_ALGORITHM=HS256

# Keycloak
KEYCLOAK_URL=
KEYCLOAK_REALM=wellq
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_ROLE=wellq-admin

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=WellQ Admin
SMTP_FROM_EMAIL=

# Mejora #19 - Notificaciones de incidentes (Email y Slack)
INCIDENT_NOTIFICATIONS_ENABLED=true
INCIDENT_MIN_SEVERITY=high
# Opcional: lista fija separada por comas. Vacio = admins con platform.manage
INCIDENT_EMAIL_RECIPIENTS=
# Webhook entrante de Slack (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

